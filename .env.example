# ==============================================================================
# Valence OTC Crypto - Netlify & Cloudflare Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare D1 Serverless SQL Database
# ------------------------------------------------------------------------------
# Found in Cloudflare Dashboard: Overview / Account ID
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Found in Cloudflare Dashboard: Workers & Pages -> D1 SQL Databases -> Database Settings
CLOUDFLARE_DATABASE_ID=your_d1_database_uuid_here

# Cloudflare API Token with "D1 Edit / Read" permissions
# Created at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ------------------------------------------------------------------------------
# 2. Admin Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing session verification tokens
ADMIN_JWT_SECRET=super-secure-random-secret-key-change-this-in-production

# Default admin fallback username & password (used if Cloudflare D1 is not linked yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=valence2026!
